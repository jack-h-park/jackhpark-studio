#!/usr/bin/env bash
# pre-push hook — blocks pushes when react-notion-x is in local dev mode.
#
# Install (one-time): pnpm run setup-hooks
# Or manually:        cp scripts/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

set -e

PKG="package.json"

# Check for local file: / link: references in dependencies
if grep -qE '"(file|link):.*forks' "$PKG" 2>/dev/null; then
  echo ""
  echo "╔═══════════════════════════════════════════════════════════════╗"
  echo "║  ❌  Push blocked — react-notion-x is in LOCAL mode           ║"
  echo "║                                                               ║"
  echo "║  package.json still has file:/link: references to the fork.  ║"
  echo "║  Run one of the following before pushing:                     ║"
  echo "║                                                               ║"
  echo "║  • To publish a new fork release and switch:                  ║"
  echo "║      pnpm deps:release                  (auto-increments tag) ║"
  echo "║      pnpm deps:release 7.7.1-jp.5       (explicit tag)        ║"
  echo "║                                                               ║"
  echo "║  • To switch without releasing (reuse existing tag):          ║"
  echo "║      node scripts/switch-rnx-deps.js remote <tag>             ║"
  echo "║      pnpm install                                             ║"
  echo "╚═══════════════════════════════════════════════════════════════╝"
  echo ""
  exit 1
fi

# Check pnpm.overrides for local links
if node -e "
  const p = JSON.parse(require('fs').readFileSync('package.json','utf8'));
  const ov = p?.pnpm?.overrides ?? {};
  const hasLocal = Object.values(ov).some(v => v.startsWith('file:') || v.startsWith('link:'));
  process.exit(hasLocal ? 1 : 0);
" 2>/dev/null; then
  : # overrides are clean
else
  echo ""
  echo "╔═══════════════════════════════════════════════════════════════╗"
  echo "║  ❌  Push blocked — pnpm.overrides has local links            ║"
  echo "║  Run: pnpm deps:release  or  switch-rnx-deps.js remote <tag>  ║"
  echo "╚═══════════════════════════════════════════════════════════════╝"
  echo ""
  exit 1
fi

# ESLint: autofix then verify on .ts/.tsx files in commits about to be pushed.
# Uses @{push}..HEAD to scope to only new commits; falls back to HEAD~1..HEAD.
# --diff-filter=ACMR excludes deletions so ESLint never receives a path that no
# longer exists on disk (a deleted/renamed-away file would abort the push).
CHANGED_TS=$(git diff --name-only --diff-filter=ACMR "@{push}..HEAD" 2>/dev/null | grep -E '\.(ts|tsx)$' || git diff --name-only --diff-filter=ACMR HEAD~1..HEAD 2>/dev/null | grep -E '\.(ts|tsx)$' || true)
if [ -n "$CHANGED_TS" ]; then
  # Resolve ESLint by path rather than through `pnpm`, which only looks in the
  # current directory. A git worktree has no node_modules of its own, so fall
  # back to the main checkout's install — the parent of the shared git dir.
  # Without this, every push from a worktree died on "Command eslint not found"
  # under a banner that reads like a lint failure.
  ESLINT_BIN=""
  for candidate in \
    "$(git rev-parse --show-toplevel)/node_modules/.bin/eslint" \
    "$(dirname "$(cd "$(git rev-parse --git-common-dir)" && pwd)")/node_modules/.bin/eslint"; do
    if [ -x "$candidate" ]; then
      ESLINT_BIN="$candidate"
      break
    fi
  done

  if [ -z "$ESLINT_BIN" ]; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║  ❌  Push blocked — ESLint could not be found                 ║"
    echo "║                                                               ║"
    echo "║  Dependencies are not installed, so the changed files cannot  ║"
    echo "║  be verified. Run 'pnpm install', then re-run git push.       ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
  fi

  echo "Running ESLint autofix on changed .ts/.tsx files..."
  # shellcheck disable=SC2086
  "$ESLINT_BIN" --fix $CHANGED_TS 2>&1 || true

  echo "Verifying no remaining ESLint errors..."
  # shellcheck disable=SC2086
  if ! "$ESLINT_BIN" $CHANGED_TS 2>&1; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║  ❌  Push blocked — ESLint errors remain after autofix        ║"
    echo "║                                                               ║"
    echo "║  Fix the errors above, then re-run git push.                  ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
  fi
fi

exit 0
