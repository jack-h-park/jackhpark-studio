{
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "redirects": [
    {
      "source": "/assets/brand-design-system-guide.html",
      "destination": "https://assets.jackhpark.com/brand-design-system-guide.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "https://www.jackhpark.com/chat",
      "has": [
        {
          "type": "host",
          "value": "chat.jackhpark.com"
        }
      ]
    },
    {
      "source": "/security/(.*)",
      "destination": "https://mcp-security-incidents.vercel.app/$1"
    },
    {
      "source": "/security",
      "destination": "https://mcp-security-incidents.vercel.app"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/rag/snapshot",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/rag/ingest",
      "schedule": "0 7 * * *"
    }
  ]
}
